@import "styles/fonts.wxss";
.kai{font-family:'Tree WenKai','Kaiti SC','STKaiti','KaiTi',serif}
/* 自定义底部导航为固定定位，tab 页底部留出等高空间 */
page{background:#f5f3e8;color:#3f4936;font-family:-apple-system,'PingFang SC','Microsoft YaHei',sans-serif;font-size:28rpx;line-height:1.65}view,button,input,textarea{box-sizing:border-box}button{margin:0;padding:0;background:none;border:0;border-radius:0;color:inherit;font-size:28rpx;line-height:1.5}button::after{border:0}button[disabled]{opacity:.45;color:inherit}image{display:block}input,textarea{width:100%;font:inherit;color:#3f4936}textarea{line-height:1.8}page .serif{font-family:'Tree WenKai','Kaiti SC','STKaiti','KaiTi',serif}.page{padding:36rpx 34rpx calc(60rpx + 150rpx + env(safe-area-inset-bottom))}.title{font-size:42rpx;font-weight:400;font-family:'Tree WenKai','Kaiti SC','STKaiti','KaiTi',serif;line-height:1.4}.subtitle{color:#676f5d;font-size:26rpx;margin-top:12rpx}.muted{color:#676f5d;font-size:24rpx}.header{display:flex;justify-content:space-between;align-items:center;margin-bottom:32rpx}.primary{display:block;background:#506342;color:#f5f3e8;border-radius:56rpx;padding:26rpx 34rpx;text-align:center;font-weight:500}.secondary{display:block;border:1rpx solid #daddcb;border-radius:48rpx;padding:22rpx 28rpx;color:#61704f;background:#fbf9f0}.quiet{color:#61704f;font-size:26rpx;padding:16rpx}.card{border:1rpx solid #daddcb;background:#fbf9f0;border-radius:32rpx;padding:30rpx}.empty{padding:42rpx 24rpx;text-align:center;color:#676f5d}.empty .secondary{margin:26rpx auto 0;max-width:360rpx}.error{padding:28rpx;background:#f5e9e3;border-radius:24rpx;margin:20rpx 0;color:#854d40}.error button{margin-top:16rpx;text-decoration:underline}.section-title{font-family:'Tree WenKai','Kaiti SC','STKaiti','KaiTi',serif;font-size:34rpx;margin:34rpx 0 20rpx}.row{display:flex;justify-content:space-between;align-items:center;gap:20rpx}.field{display:block;margin-top:28rpx}.label{display:block;font-size:26rpx;color:#676f5d;margin-bottom:12rpx}.field input,.field textarea,.picker{background:#fbf9f0;border:1rpx solid #daddcb;border-radius:20rpx;padding:22rpx 24rpx;min-height:88rpx}.field textarea{height:280rpx}.count{text-align:right;color:#7d8471;font-size:22rpx;margin:8rpx 6rpx}.space{height:26rpx}.danger{color:#a44e45}.rule{height:1rpx;background:#daddcb;margin:24rpx 0}.center{text-align:center}.note{font-size:24rpx;color:#676f5d;line-height:1.85}.pill{display:inline-block;background:#e8ebda;color:#61704f;border-radius:30rpx;padding:8rpx 20rpx;font-size:24rpx}.reading{white-space:pre-wrap;word-break:break-word}.photo{width:100%;border-radius:24rpx}.menu-row{width:100%;display:flex;justify-content:space-between;padding:28rpx 0;border-bottom:1rpx solid #daddcb;text-align:left}.menu-row:last-child{border:0}.month-picker{border:1rpx solid #daddcb;border-radius:36rpx;padding:12rpx 24rpx;color:#61704f}.privacy-link{font-size:24rpx;color:#61704f;text-decoration:underline;padding:16rpx}
