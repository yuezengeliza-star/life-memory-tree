.overlay{position:fixed;top:0;right:0;bottom:0;left:0;z-index:1000;background:rgba(40,36,28,.38);display:flex;align-items:center;justify-content:center}.dialog{width:620rpx;box-sizing:border-box;background:#fbf9f0;border-radius:36rpx;padding:40rpx;color:#3f4936}.heading{font-size:36rpx;font-weight:600}.copy{font-size:28rpx;line-height:1.8;margin:24rpx 0}.read,.refuse{font-size:26rpx;color:#61704f;padding:20rpx 0;background:transparent}.agree{background:#506342;color:#f5f3e8;border-radius:50rpx;font-size:28rpx;padding:12rpx}.read::after,.refuse::after,.agree::after{border:0}
