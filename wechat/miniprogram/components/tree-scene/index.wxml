<view class="scene"><image class="tree" src="/assets/tree.png" mode="aspectFit"/><button wx:for="{{nodes}}" wx:key="id" class="node {{item.precious ? 'precious' : ''}}" style="left:{{item.x}}%;top:{{item.y}}%;" bindtap="open" data-id="{{item.id}}" aria-label="打开记忆：{{item.title}}"><image wx:if="{{item.photoFileId}}" class="node-photo" src="{{item.photoFileId}}" mode="aspectFill"/><view wx:else class="leaf" style="background:{{item.color}}"><image class="leaf-icon" src="/assets/icons/kind-{{item.kind || 'leaf'}}-white.svg" mode="aspectFit" aria-hidden="true"/></view></button></view>
