.scene{position:relative;width:100%;height:760rpx;background:radial-gradient(ellipse at 70% 25%,rgba(248,228,164,.25),transparent 60%)}.tree{position:absolute;width:100%;height:100%;left:0;top:0}.node{position:absolute;z-index:2;display:flex;align-items:center;justify-content:center;transform:translate(-50%,-50%);width:88rpx;height:88rpx;margin:0;padding:0;border-radius:50%;background:transparent;line-height:1}.node::after{border:0}.leaf{width:48rpx;height:60rpx;border-radius:80% 10% 80% 10%;display:flex;align-items:center;justify-content:center;color:#fbf9f0;font-size:22rpx;border:2rpx solid #f5f3e8;box-shadow:0 4rpx 16rpx #4c503640}.node-photo{width:64rpx;height:64rpx;border:4rpx solid #fbf9f0;box-sizing:border-box;border-radius:50%}.precious{background:radial-gradient(circle,#f7dd8a99,transparent 70%)}
.leaf-icon{width:30rpx;height:30rpx}
