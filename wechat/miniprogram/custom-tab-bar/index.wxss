/* 设计稿 .dg-tab-bar（森林版覆盖规则）：#f5f3e8 底、#daddcb 顶线、
   默认 #676f5d / 选中 #506342、系统字体；中间胶囊 38x31 r9 bg #506342 */
.bar {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  align-items: center;
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  padding: 10rpx 14rpx calc(22rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #daddcb;
  background: #f5f3e8;
  color: #676f5d;
  font-family: -apple-system, 'PingFang SC', 'HarmonyOS Sans SC', 'Microsoft YaHei', sans-serif;
}
.item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  padding: 0;
  margin: 0;
  background: none;
  border: 0;
  border-radius: 0;
  min-height: 124rpx;
}
.item::after { border: 0; }
.item.active { color: #506342; font-weight: 500; }
.icon { display: grid; place-items: center; min-height: 54rpx; }
.tab-icon { width: 42rpx; height: 42rpx; }
.item.capture .icon {
  width: 76rpx;
  height: 62rpx;
  border-radius: 18rpx;
  background: #506342;
  color: #f5f3e8;
}
.item.capture .icon .tab-icon { width: 42rpx; height: 42rpx; }
.label { display: block; }
