<view class="page"><view class="header"><view class="title">{{editing ? '重写这一刻' : '此刻，想记住什么'}}</view><button class="quiet" disabled="{{saving}}" bindtap="cancel">{{editing ? '取消' : '清空'}}</button></view><view class="subtitle">不必完整，也不必漂亮</view><view wx:if="{{draftNotice}}" class="note">{{draftNotice}}</view><view wx:if="{{loading}}" class="empty">正在读取…</view><button class="photo-picker" bindtap="photo" disabled="{{saving}}"><image wx:if="{{filePath || form.photoFileId}}" class="picker-photo" src="{{filePath || form.photoFileId}}" mode="aspectFill"/><view wx:else><view class="photo-plus">＋</view><view>选择一张照片</view><view class="muted">也可以只写一句话</view></view></button><button wx:if="{{filePath || form.photoFileId}}" class="quiet" bindtap="removePhoto" disabled="{{saving}}">移除照片</button><view wx:if="{{filePath || form.photoFileId}}" class="row field"><text>照片只存本机，不上传</text><switch color="#61704f" checked="{{form.photoLocal}}" data-field="photoLocal" bindchange="toggle" disabled="{{saving}}"/></view><view wx:if="{{(filePath || form.photoFileId) && form.photoLocal}}" class="note">照片留在这台手机，不进云端。换手机或重装微信会丢失，重要的照片记得在详情里存到相册</view><label class="field"><text class="label">给这一刻起个名字（选填）</text><input value="{{form.title}}" data-field="title" bindinput="input" maxlength="40" placeholder="如：回家吃的一顿晚饭" disabled="{{saving}}"/></label><view class="field"><text class="label">那一刻的感受</text><textarea value="{{form.content}}" data-field="content" bindinput="input" maxlength="2000" placeholder="写下一句真实的感受…" disabled="{{saving}}"/><view class="count">{{form.content.length}} / 2000</view></view><view class="field"><text class="label">发生的日期</text><picker mode="date" value="{{form.date}}" start="1900-01-01" end="2100-12-31" data-field="date" bindchange="input" disabled="{{saving}}"><view class="picker">{{form.date}} ▾</view></picker></view><view class="field"><text class="label">它长成什么样子</text><view class="kinds"><button wx:for="{{kinds}}" wx:key="id" class="kind {{form.kind === item.id ? 'selected' : ''}}" data-kind="{{item.id}}" bindtap="kind" disabled="{{saving}}"><text class="kind-glyph" style="color:{{item.color}}">{{item.symbol}}</text>{{item.name}}</button></view></view><label class="field"><text class="label">人物（选填）</text><input value="{{form.people}}" data-field="people" bindinput="input" maxlength="80" placeholder="和谁一起，或是独自一人" disabled="{{saving}}"/></label><label class="field"><text class="label">地点（选填）</text><input value="{{form.scene}}" data-field="scene" bindinput="input" maxlength="80" placeholder="手动写下当时的地方" disabled="{{saving}}"/></label><view class="field"><text class="label">写给未来的我（选填）</text><textarea class="echo-input" value="{{form.echo}}" data-field="echo" bindinput="input" maxlength="500" placeholder="下次读到这里时，想提醒自己什么？" disabled="{{saving}}"/></view><view class="row field"><text>标记为珍贵记忆</text><switch color="#728463" checked="{{form.precious}}" bindchange="precious" disabled="{{saving}}"/></view><view wx:if="{{error}}" class="error">{{error}}</view><view class="space"/><button class="primary" bindtap="save" loading="{{saving}}" disabled="{{saving || loading || !form.content}}">{{saving ? '正在保存…' : editing ? '保存修改' : '种下这一刻'}}</button><button class="privacy-link" bindtap="privacy">私人保存 · 查看隐私说明</button></view><privacy-consent id="privacy"/>
