.title{font-size:38rpx;white-space:nowrap}.photo-picker{position:relative;width:100%;height:330rpx;border:1rpx dashed #a8b295;border-radius:30rpx;background:#eff1e4;display:flex;align-items:center;justify-content:center;margin-top:34rpx;color:#61704f}.picker-photo{width:100%;height:100%;border-radius:30rpx}.photo-plus{font-size:50rpx}.kinds{display:flex;flex-wrap:wrap;gap:14rpx}.kind{width:calc((100% - 28rpx)/3);border:1rpx solid #daddcb;border-radius:20rpx;padding:18rpx 0;background:#fbf9f0;display:flex;align-items:center;justify-content:center;gap:12rpx;font-size:26rpx}.kind-glyph{font-family:serif;font-size:32rpx}.kind.selected{border-color:#61704f;background:#e8ebda}.field .echo-input{height:190rpx}
