<view class="page"><view wx:if="{{loading}}" class="empty">正在翻开这一刻…</view><view wx:elif="{{error}}" class="error">{{error}}<button bindtap="retry">重试</button></view><block wx:elif="{{memory}}"><view class="row"><text class="muted">{{memory.dateText}}</text><text class="pill">{{memory.kindName}}</text></view><view class="title detail-title">{{memory.title}}</view><image wx:if="{{photoSrc}}" class="photo detail-photo" src="{{photoSrc}}" mode="widthFix" bindtap="photo"/><view wx:if="{{photoLocal}}" class="note">照片只存在这台手机，没有上传云端<text class="album-link" bindtap="saveAlbum">存到相册</text></view>
<view class="reading content">{{memory.content}}</view><view wx:if="{{memory.people || memory.scene}}" class="card"><view wx:if="{{memory.people}}" class="note">人物　{{memory.people}}</view><view wx:if="{{memory.scene}}" class="note">地点　{{memory.scene}}</view></view><view wx:if="{{memory.echo}}" class="echo"><view class="muted">写给未来的我</view><view class="reading">{{memory.echo}}</view></view><view class="space"/><button class="secondary" bindtap="precious" disabled="{{busy}}">{{memory.precious ? '♥ 已标记珍贵 · 点击取消' : '♡ 标记为珍贵'}}</button><view class="space"/><button class="primary" bindtap="edit" disabled="{{busy}}">编辑记忆</button><button class="quiet danger" bindtap="remove" disabled="{{busy}}">删除这段记忆</button></block></view><privacy-consent id="privacy"/>
