/* 「山林来信」楷体版首页 —— 全部数值取自设计稿 .dg-forest 规则（px × 2 = rpx） */
.home{min-height:100vh;background:#f5f3e8;padding-bottom:calc(150rpx + env(safe-area-inset-bottom))}
/* .dg-forest-opening：min-height 426px / padding 18px 26px 0 */
.opening{position:relative;overflow:hidden;min-height:852rpx;background:linear-gradient(165deg,#3f4936 25%,#59634d 100%);padding:36rpx 52rpx 0}
/* .dg-date：12px 系统 #d3d7bf */
.date{font-size:24rpx;line-height:1.6;color:#d3d7bf}
.title{font-size:72rpx;line-height:1.35;letter-spacing:2rpx;color:#f5efdd;margin-top:38rpx}
.verse{font-size:26rpx;line-height:1.9;letter-spacing:1rpx;color:#d7dbc4;margin-top:40rpx}
.verse-line{display:block}
.tree{position:absolute;height:600rpx;width:400rpx;right:-56rpx;bottom:-41rpx;opacity:.97;pointer-events:none}
.caption{position:absolute;left:52rpx;bottom:69rpx;z-index:1;display:flex;flex-direction:column;align-items:flex-start;gap:9rpx}
.cap-label{font-size:24rpx;color:#e1e3cf}
.cap-year{font-size:46rpx;line-height:1.4;color:#f0e4bc;letter-spacing:4rpx}
/* .dg-forest-caption>small：系统字体 12px */
.cap-note{font-size:24rpx;line-height:1.6;color:#e1e3cf}
/* .dg-forest-base：圆角 21px、上移 18px、accent 覆盖 #61704f */
.base{position:relative;z-index:2;background:#f5f3e8;color:#3f4936;border-radius:42rpx 42rpx 0 0;margin-top:-36rpx;padding-top:2rpx}
/* .dg-forest-base>.dg-record-action：金底 #e2d5ae、楷体 17px、圆角 6px、min-height 49px */
.record{display:flex;align-items:center;justify-content:center;gap:20rpx;margin:38rpx 44rpx 0;min-height:98rpx;background:#e2d5ae;color:#3f4936;font-size:34rpx;font-weight:400;letter-spacing:2rpx;font-family:'Tree WenKai','Kaiti SC','STKaiti','KaiTi',serif;border-radius:12rpx;padding:24rpx 30rpx}
.record-icon{width:38rpx;height:38rpx;flex-shrink:0}
.error-block{margin:30rpx 41rpx 0;padding:28rpx;background:#f5e9e3;border-radius:11rpx;color:#854d40;font-size:26rpx;line-height:1.7}
.error-block .retry{margin-top:16rpx;color:#854d40;font-size:26rpx;text-decoration:underline;padding:0}
.consent-card{margin:36rpx 41rpx 0;border:1rpx solid #daddcb;border-radius:11rpx;background:#faf8ee;padding:34rpx 30rpx}
.consent-title{font-size:32rpx;line-height:1.7;font-family:'Tree WenKai','Kaiti SC','STKaiti','KaiTi',serif}
.privacy-link{margin-top:24rpx;color:#61704f;font-size:26rpx;text-decoration:underline;padding:0}
.consent-card .record{margin-top:20rpx}
/* .dg-recent：padding 20px 23px 24px */
.recent{padding:40rpx 46rpx 48rpx}
.recent-header{display:flex;justify-content:space-between;align-items:baseline;gap:20rpx;margin-bottom:24rpx}
/* .dg-forest .dg-recent h3：20px 楷体 400 */
.recent-title{font-size:40rpx;font-weight:400;color:#3f4936;font-family:'Tree WenKai','Kaiti SC','STKaiti','KaiTi',serif}
/* .dg-recent>header>span：系统 12px #676f5d */
.recent-all{color:#676f5d;font-size:24rpx;padding:8rpx 0;line-height:1.6}
.empty{padding:80rpx 45rpx;text-align:center;color:#676f5d;font-size:26rpx;line-height:1.9}
/* .dg-private：系统 12px、挂锁图标 12px、gap 5px、padding 0 13px 16px */
.private{display:flex;align-items:center;justify-content:center;gap:10rpx;padding:0 26rpx 32rpx;text-align:center;color:#676f5d;font-size:24rpx;line-height:1.7}
.lock-icon{width:24rpx;height:24rpx;flex-shrink:0}
