/* 回望页（按设计稿重排）：大数字月份 + 统计卡 + 填充回忆卡 + 日期轴时间线 */
.review-page{padding-top:24rpx}
.head{margin-bottom:36rpx}
.head-year{font-size:28rpx;color:#676f5d;line-height:1.6}
.head-month{display:flex;align-items:center;gap:18rpx;margin-top:4rpx}
.head-month-num{font-size:84rpx;line-height:1.15;color:#3f4936;letter-spacing:2rpx}
.month-drop{width:56rpx;height:44rpx;border-radius:12rpx;background:#e8ebda;color:#61704f;font-size:26rpx;display:flex;align-items:center;justify-content:center}
.subtitle{font-size:26rpx;color:#676f5d;margin-top:10rpx}

/* 统计卡：三列均分，列间细线 */
.stats-card{display:flex;background:#e8ebda;border-radius:20rpx;padding:34rpx 0;margin-top:34rpx}
.stat{flex:1;text-align:center;padding:0 8rpx}
.stat+.stat{border-left:1rpx solid rgba(63,73,54,.12)}
.stat-n{display:block;font-size:48rpx;line-height:1.2;color:#3f4936}
.stat-l{display:block;font-size:24rpx;color:#676f5d;margin-top:8rpx}

/* 写给未来的话：填充卡片 */
.echo-card{background:#edeade;border-radius:18rpx;padding:30rpx;margin-bottom:20rpx}
.echo-card .reading{font-family:'Tree WenKai','Kaiti SC','STKaiti','KaiTi',serif;font-size:32rpx;line-height:1.75;color:#3f4936}
.echo-card .muted{margin-top:18rpx;font-size:24rpx;color:#676f5d}

/* 时间线 */
.timeline{margin-top:6rpx}
.tl-item{display:flex;align-items:stretch;padding-bottom:36rpx}
.tl-item.last{padding-bottom:8rpx}
.tl-date{width:96rpx;flex:none;text-align:right;padding-top:2rpx}
.tl-m{display:block;font-size:22rpx;color:#676f5d;line-height:1.4}
.tl-d{display:block;font-size:40rpx;color:#3f4936;line-height:1.2}
.tl-spine{width:44rpx;flex:none;position:relative;display:flex;justify-content:center}
.tl-spine::before{content:'';position:absolute;top:0;bottom:0;left:50%;width:1rpx;background:#daddcb;transform:translateX(-50%)}
.tl-item.last .tl-spine::before{display:none}
.tl-dot{position:relative;width:12rpx;height:12rpx;border-radius:50%;background:#61704f;margin-top:18rpx}
.tl-body{flex:1;min-width:0;display:flex;gap:24rpx}
.tl-thumb{width:132rpx;height:132rpx;flex:none;border-radius:14rpx}
.tl-kind{background:#e8ebda;display:flex;align-items:center;justify-content:center;padding:10rpx}
.tl-kind image{width:72rpx;height:72rpx}
.tl-text{flex:1;min-width:0;padding-top:6rpx}
.tl-title{font-size:30rpx;color:#3f4936;line-height:1.5;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}
.tl-excerpt{font-size:26rpx;color:#676f5d;line-height:1.6;margin-top:8rpx;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical}
.tl-date{font-size:24rpx;color:#676f5d;margin-top:10rpx}
