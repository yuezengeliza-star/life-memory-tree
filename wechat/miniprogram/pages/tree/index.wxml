<view class="page tree-page"><view class="header"><view class="title">我的人生树</view><button class="quiet" bindtap="all">{{all ? '回到本月' : '全部年月'}}</button></view><view class="row"><view class="subtitle">每一片叶子都是时光的礼物</view><picker mode="date" fields="month" value="{{month}}" start="1900-01" end="2100-12" bindchange="onMonth"><view class="month-picker">{{month}} ▾</view></picker></view><tree-scene records="{{filtered}}" bind:open="open"/><view class="row tree-bottom"><view><view class="serif">{{all ? '所有年月' : month}} · {{filtered.length}} 个瞬间</view><view class="muted">轻触树上的枝叶，打开记忆</view></view><button class="secondary" bindtap="capture">＋ 留下</button></view><view wx:if="{{needsConsent}}" class="empty"><button class="secondary" bindtap="begin">开始使用</button></view><view wx:if="{{error}}" class="error">{{error}}<button bindtap="retry">重试</button></view><view class="search"><image class="search-icon" src="/assets/icons/search.svg" mode="aspectFit" aria-hidden="true"/><input class="search-input" type="text" placeholder="搜索标题、感受、人物或地点" value="{{query}}" bindinput="onQuery" maxlength="100"/></view><view class="row"><view class="section-title">枝头的记忆</view><button class="quiet" bindtap="precious">{{precious ? '✓ 只看珍贵' : '只看珍贵'}}</button></view><view wx:if="{{loading}}" class="empty">正在读取…</view><memory-list wx:elif="{{filtered.length}}" records="{{filtered}}" bind:open="open"/><view wx:elif="{{!error}}" class="empty">{{query || precious ? '没有找到匹配的记忆，试试调整筛选。' : '这里还没有记忆，留下第一个瞬间吧。'}}</view></view><privacy-consent id="privacy"/>
